# Tahfidzku — Apache hardening (shared hosting)

# Block web access to dotfiles (.env, .secret) and SQLite DB files
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
<FilesMatch "\.(sqlite|sqlite3|db|log)$">
    Require all denied
</FilesMatch>

# Forward Authorization header so PHP-FPM/FastCGI sees it (Bearer tokens)
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
