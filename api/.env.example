# Tahfidzku — Environment Configuration
# Copy this file to .env and edit values for your setup.

# ---- Database ----
# Use 'sqlite' for local dev (no MySQL needed) or 'mysql' for production
DB_DRIVER=sqlite
DB_HOST=localhost
DB_NAME=tahfidzku
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# ---- Security ----
# APP_SECRET: HMAC signing key for auth tokens.
# If left empty, a random secret is auto-generated and saved to .secret file.
# For production, set this to a long random string (min 32 chars).
# Generate one: php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=

# CORS_ALLOW_ORIGIN: Comma-separated list of allowed origins.
# Example: https://tahfidzku.com,https://www.tahfidzku.com
# Leave empty for same-origin only (recommended).
CORS_ALLOW_ORIGIN=

# APP_TIMEZONE: zona waktu lembaga, mis. Asia/Jakarta.
# Server sering berjalan di UTC, sedangkan browser memakai zona waktu setempat.
# Tanpa ini, "hari ini" dan "jam kirim" rekap WA bisa berbeda sehari dari
# yang dilihat pengguna. Kosongkan untuk memakai bawaan server.
APP_TIMEZONE=Asia/Jakarta

# ---- Installer ----
# INSTALL_TOKEN: Required to run install.php. Generate a random string.
# Example: INSTALL_TOKEN=$(php -r "echo bin2hex(random_bytes(16));")
# Usage: api/install.php?token=YOUR_INSTALL_TOKEN
INSTALL_TOKEN=

# MIGRATION_TOKEN: Required only when running api/migrate.php from a browser.
# CLI migration does not need this token. Generate a different random value.
# Usage: api/migrate.php?token=YOUR_MIGRATION_TOKEN
MIGRATION_TOKEN=

# ADMIN_PASSWORD: Initial admin password (only used during install).
# If left empty, defaults to 'admin123'. Change immediately after install!
ADMIN_PASSWORD=

# ---- WhatsApp Bridge (optional) ----
# These are stored in app settings, not .env. Set via admin UI.
